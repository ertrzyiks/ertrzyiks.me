{
  "name": "task-manager",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:redis": "docker compose up -d",
    "dev:redis:down": "docker compose down",
    "worker": "tsx watch src/worker.ts",
    "worker:start": "node dist/worker.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "eval": "vitest run --config eval/vitest.config.ts",
    "eval:watch": "vitest --config eval/vitest.config.ts",
    "review": "tsx scripts/review-inspections.ts",
    "release:worker": "node scripts/release-worker.mjs"
  },
  "dependencies": {
    "@bull-board/api": "8.6.0",
    "@bull-board/fastify": "8.6.0",
    "@sentry/node": "10.70.0",
    "bullmq": "6.0.8",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "google-auth-library": "10.5.0",
    "googleapis": "173.0.0",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@yao-pkg/pkg": "6.22.0",
    "esbuild": "0.28.1",
    "tsx": "4.23.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "pkg": {
    "assets": ["dist-bin/prompts/**/*"]
  }
}

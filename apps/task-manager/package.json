{
  "name": "task-manager",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:redis": "docker compose up -d",
    "dev:redis:down": "docker compose down",
    "build": "tsc && cp -r src/modules/email-processing/queues/extract-action-items/prompts dist/modules/email-processing/queues/extract-action-items/prompts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "eval": "vitest run --config eval/vitest.config.ts",
    "eval:watch": "vitest --config eval/vitest.config.ts",
    "review": "tsx scripts/review-inspections.ts"
  },
  "dependencies": {
    "@bull-board/api": "9.10.1",
    "@bull-board/fastify": "9.10.1",
    "@sentry/node": "10.75.0",
    "bullmq": "6.3.8",
    "dotenv": "17.4.2",
    "fastify": "5.12.5",
    "google-auth-library": "10.5.0",
    "googleapis": "174.0.1",
    "ioredis": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

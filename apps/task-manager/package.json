{
  "name": "task-manager",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "tsx watch src/devServer.ts",
    "dev:redis": "docker compose up -d",
    "dev:redis:down": "docker compose down",
    "worker": "tsx watch src/worker.ts",
    "worker:start": "node dist/worker.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bullmq": "5.81.3",
    "fastify": "5.11.2",
    "google-auth-library": "10.5.0",
    "googleapis": "173.0.0",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@bull-board/api": "8.4.0",
    "@bull-board/fastify": "8.4.0",
    "@types/node": "24.13.3",
    "dotenv": "17.4.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}

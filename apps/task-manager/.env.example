REDIS_URL=redis://localhost:6379
JOBS_API_BEARER_TOKEN=local-dev-token
# Optional: set both to require Basic Auth on the Bull Board UI (/admin/queues) locally, the same
# way production always does. Leave unset for open local access.
# TASK_MANAGER_BULL_BOARD_BASIC_AUTH_USERNAME=admin
# TASK_MANAGER_BULL_BOARD_BASIC_AUTH_PASSWORD=local-dev-password
# Optional: set all three (from scripts/google-tasks-oauth) to start the sync-google-tasks
# worker locally against a real Google Tasks account. Leave unset to still accept
# /google-tasks-jobs requests — they'll just queue up unconsumed.
# GOOGLE_TASKS_CLIENT_ID=
# GOOGLE_TASKS_CLIENT_SECRET=
# GOOGLE_TASKS_REFRESH_TOKEN=
# Optional: which Google Tasks list to create tasks in (default "@default", the user's default list).
# GOOGLE_TASKS_LIST_ID=
# Optional: throttles the sync-google-tasks worker to at most _MAX jobs per _DURATION_MS, to
# avoid bursting past Google Tasks API rate limits (defaults: 5 per 1000ms).
# GOOGLE_TASKS_RATE_LIMIT_MAX=5
# GOOGLE_TASKS_RATE_LIMIT_DURATION_MS=1000

# Only needed to start the library sync workers locally — they run inside `dev`/`start` (like
# the Google Tasks ones above), no separate command. See README.md's "Library loan -> Google
# Calendar sync" section.
# DATABASE_PATH=./data/library.sqlite
# WBPG_USERNAME=your-library-card-number
# WBPG_PASSWORD=your-library-password
# GOOGLE_CALENDAR_CLIENT_ID=...
# GOOGLE_CALENDAR_CLIENT_SECRET=...
# GOOGLE_CALENDAR_REFRESH_TOKEN=...   # from scripts/calendar-oauth, needs the calendar scope
# Optional: which calendar to write to (default "primary", the refresh token account's own main
# calendar). Not a secret — the refresh token above is what actually grants access — so this is
# the real "Dom" calendar id, matching what's set in terraform/main.tf for production.
# GOOGLE_CALENDAR_ID=beff7d227de04ef6e92cec0deea77b7ef9e1a89346af7d76b047d90fff377d1c@group.calendar.google.com

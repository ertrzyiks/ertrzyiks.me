REDIS_URL=redis://localhost:6379
JOBS_API_BEARER_TOKEN=local-dev-token
# Optional: set both to require Basic Auth on the Bull Board UI (/admin/queues) locally, the same
# way production always does. Leave unset for open local access.
# TASK_MANAGER_BULL_BOARD_BASIC_AUTH_USERNAME=admin
# TASK_MANAGER_BULL_BOARD_BASIC_AUTH_PASSWORD=local-dev-password
# Optional: set to start the sync-todoist worker locally against a real Todoist account — a
# personal API token from Settings > Integrations > Developer in the Todoist app, no OAuth dance
# needed. Leave unset to still accept /todoist-jobs requests — they'll just queue up unconsumed.
# TODOIST_API_TOKEN=
# Optional: which Todoist project to create tasks in (default: the user's Inbox).
# TODOIST_PROJECT_ID=
# Optional: throttles the sync-todoist worker to at most _MAX jobs per _DURATION_MS, to
# avoid bursting past Todoist API rate limits (defaults: 5 per 1000ms).
# TODOIST_RATE_LIMIT_MAX=5
# TODOIST_RATE_LIMIT_DURATION_MS=1000

# Set all three (from scripts/calendar-oauth, needs the calendar scope) to start the
# sync-calendar-events worker locally against a real Google Calendar — see README.md's "Calendar
# event sync" section. The same three also start the library sync workers below, but only once
# WBPG_USERNAME/_PASSWORD are set too; sync-calendar-events starts on its own. Leave unset to
# still accept /calendar-event-jobs requests — they'll just queue up unconsumed.
# GOOGLE_CALENDAR_CLIENT_ID=...
# GOOGLE_CALENDAR_CLIENT_SECRET=...
# GOOGLE_CALENDAR_REFRESH_TOKEN=...
# Optional: which calendar to write to (default "primary", the refresh token account's own main
# calendar). Not a secret — the refresh token above is what actually grants access — so this is
# the real "Dom" calendar id, matching what's set in terraform/main.tf for production. Shared by
# sync-calendar-events and the library sync below.
# GOOGLE_CALENDAR_ID=beff7d227de04ef6e92cec0deea77b7ef9e1a89346af7d76b047d90fff377d1c@group.calendar.google.com
# Optional: throttles the sync-calendar-events worker to at most _MAX jobs per _DURATION_MS, same
# reasoning as TODOIST_RATE_LIMIT_MAX/_DURATION_MS above (defaults: 5 per 1000ms).
# CALENDAR_EVENTS_RATE_LIMIT_MAX=5
# CALENDAR_EVENTS_RATE_LIMIT_DURATION_MS=1000

# Only needed to start the library sync workers locally — they run inside `dev`/`start` (like
# the Todoist ones above), no separate command, and need the three GOOGLE_CALENDAR_* vars
# above too. See README.md's "Library loan -> Google Calendar sync" section.
# DATABASE_PATH=./data/library.sqlite
# WBPG_USERNAME=your-library-card-number
# WBPG_PASSWORD=your-library-password

# Set all four to start the extract-action-items worker locally against real Gmail/OpenRouter —
# see README.md's "Email action-item extraction" section. Leave unset to still accept `POST /jobs`
# requests — they'll just queue up unconsumed.
#
# GMAIL_CLIENT_ID/_SECRET/_REFRESH_TOKEN: the same gmail.readonly OAuth credential
# personal-assistant uses (see scripts/gmail-oauth/README.md) — a message-id-only reader there,
# this is the only place that ever reads full email content.
# GMAIL_CLIENT_ID=...
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
#
# OPENROUTER_API_KEY: an API key from https://openrouter.ai/keys (free to create; OpenRouter's
# `:free`-suffixed models cost nothing to call, subject to their own rate limits). This is where
# email content is sent to be read and turned into action items/events — see openRouter.ts's
# header comment for that trade-off versus the local-only LM Studio setup this replaced.
# OPENROUTER_API_KEY=
# Optional: pins a specific model to call. Left unset (the default), requests go to
# "openrouter/free" — OpenRouter's own first-party free-model auto-router, which resolves to
# whichever specific free model/provider is actually available and compliant with this account's
# own settings (workspace guardrails, rate limits, outages) at request time. That means no model id
# to keep up to date by hand, but also less certainty about exactly which model/provider ends up
# reading your email — set this if you'd rather know and control that (see
# https://openrouter.ai/models?max_price=0 for the current free lineup to choose from).
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: overrides OpenRouter's own base URL — no reason to set this outside of testing against
# a compatible proxy.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: throttles the extract-action-items worker to at most _MAX jobs per _DURATION_MS, since
# free OpenRouter models enforce their own (often quite low) requests-per-minute ceiling (default:
# 5 per 60000ms — tune down further if OpenRouter starts responding with 429s).
# EXTRACT_ACTION_ITEMS_RATE_LIMIT_MAX=5
# EXTRACT_ACTION_ITEMS_RATE_LIMIT_DURATION_MS=60000
# Optional: also read by `pnpm --filter task-manager eval` (eval/vitest.config.ts loads this same
# .env; see README's "Evaluating the extraction prompt" section) — GMAIL_* aren't needed there,
# only OPENROUTER_API_KEY/_MODEL/_BASE_URL, since the eval harness calls the extractor directly
# against hand-picked/flagged fixture emails rather than fetching real Gmail messages.

# Optional: set both to emit trend events to Axiom (#315) from extract-action-items, sync-todoist,
# and sync-calendar-events jobs — a no-op, not an error, while either is unset.
# AXIOM_TOKEN=
# AXIOM_DATASET=task-manager-events

# Optional: set to report crashes/unhandled errors to Sentry (see src/sentry.ts) — a no-op
# while unset.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

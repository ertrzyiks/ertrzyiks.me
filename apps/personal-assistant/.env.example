GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
JOBS_API_BASE_URL=http://localhost:3000
JOBS_API_BEARER_TOKEN=local-dev-token
DATABASE_PATH=./data/personal-assistant.sqlite
POLL_INTERVAL_MS=300000
GMAIL_MAX_RESULTS=50
# Guards the snapshot dashboard at GET /admin/status — required (the app won't start without
# both set, unlike task-manager's optional Bull Board Basic Auth vars).
PERSONAL_ASSISTANT_DASHBOARD_BASIC_AUTH_USERNAME=admin
PERSONAL_ASSISTANT_DASHBOARD_BASIC_AUTH_PASSWORD=local-dev-password
# Optional: set both to emit trend events to Axiom (#315) from poller.ts — a no-op, not an
# error, while either is unset.
# AXIOM_TOKEN=
# AXIOM_DATASET=personal-assistant-events

---
// Dev-only harness for interaction tests (docs/adr/0001). Boots the real
// MainWorld against a minimal 2-tile board — no Stage 1 wolves, and no
// narrative by default (?narrative=1 opts in a single test-only beat, see
// createHarnessNarrativeScript) — so a real browser click can be driven
// through the actual PixiJS pointertap -> handleTileClick path without
// mounting the whole game.
// Inert in a production build: any request here redirects to the homepage.
if (!import.meta.env.DEV) {
  return Astro.redirect("/");
}
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Interaction harness</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        overflow: hidden;
      }
      canvas {
        display: block;
      }
    </style>
  </head>
  <body>
    <div id="game"></div>
    <script>
      window.global ||= window;

      import { Application } from "pixi.js";
      import TWEEN from "@tweenjs/tween.js";
      import { preload } from "../game/main/preload";
      import { MainWorld } from "../game/main/game_world";
      import {
        createHarnessBoard,
        createHarnessDefinition,
        createHarnessDefinitionWithEnemy,
        createHarnessDefinitionWithTwoEnemies,
        createHarnessDefinitionWithAdjacentEnemy,
        createHarnessNarrativeScript,
      } from "../game/main/harness/interaction_harness";
      import { cubeKey } from "../game/core/grid/helpers";

      async function bootstrap() {
        const app = new Application();
        await app.init({
          backgroundAlpha: 0,
          resolution: window.devicePixelRatio,
        });
        app.ticker.add(() => {
          TWEEN.update();
        });

        const { sheet, unitsSheet } = await preload();

        // Default stays no narrative script — nothing should block input in
        // the harness (docs/adr/0001). ?narrative=1 opts a specific test into
        // the harness's one-beat script — see createHarnessNarrativeScript's
        // own doc comment for which regression that's for.
        const params = new URLSearchParams(window.location.search);
        const narrativeScript = params.has("narrative")
          ? createHarnessNarrativeScript()
          : [];
        // ?enemy=1 opts into a single stationary Damageable target (see
        // createHarnessDefinitionWithEnemy's own doc comment) — for
        // interaction/auto-attack-move.spec.ts (ADR-0004). ?enemy=2 opts into
        // two at once — for interaction/auto-attack-choice.spec.ts, the
        // ambiguous-targets case.
        const definition = params.get("enemy") === "2"
          ? createHarnessDefinitionWithTwoEnemies()
          : params.get("enemy") === "adjacent"
            ? createHarnessDefinitionWithAdjacentEnemy()
            : params.has("enemy")
              ? createHarnessDefinitionWithEnemy()
              : createHarnessDefinition();

        const world = new MainWorld(
          createHarnessBoard(),
          app.renderer.events,
          sheet,
          unitsSheet,
          definition,
          narrativeScript
        );

        app.stage.addChild(world);

        function resize() {
          app.renderer.resize(window.innerWidth, window.innerHeight);
        }
        window.addEventListener("resize", resize);
        resize();

        const gameEl = document.getElementById("game");
        gameEl?.replaceWith(app.canvas as HTMLCanvasElement);
        app.start();

        (window as any).__debugApp = app;
        (window as any).__debugWorld = world;

        // The only test-specific surface in this whole harness (docs/adr/0001:
        // MainWorld itself stays unaware tests exist beyond the generic
        // constructor seam) — interaction/*.spec.ts reads through this after
        // driving real pixel clicks on the canvas. Returns plain data only
        // (never a GameTileHex/Unit instance) so it survives Playwright's
        // evaluate() serialization boundary intact.
        window.__test = {
          getTileScreenPositionBySection: (sectionName: string) =>
            world.getTileScreenPositionBySection(sectionName),
          getUnitSectionByOwner: (ownerId: string): string | null => {
            const state = world.getState();
            const unit = state.units.find((u) => u.owner.id === ownerId);
            if (!unit) return null;
            const key = cubeKey(unit.position);
            const tile = state.tiles.find((t) => cubeKey(t.cube()) === key);
            return tile?.sectionName ?? null;
          },
          // Distinguishes two same-owner units by section (getUnitSectionByOwner
          // can't — state.units.find() only ever returns the first match for a
          // given owner) — for auto-attack-choice.spec.ts's 2-eligible-targets case.
          isSectionOccupied: (sectionName: string): boolean => {
            const state = world.getState();
            const tile = state.tiles.find((t) => t.sectionName === sectionName);
            if (!tile) return false;
            const key = cubeKey(tile.cube());
            return state.units.some((u) => cubeKey(u.position) === key);
          },
          // Stands in for StageManager destroying the current MainWorld on a
          // stage win/loss (main/stage_manager.ts's onStageEnded) — for
          // destroy-mid-async-action.spec.ts (issue #175).
          destroyWorld: () => {
            world.destroy({ children: true });
          },
          // The turn counter (core/reducers's StartTurn case increments it)
          // — for auto-end-turn.spec.ts (issue #329): draining every unit's
          // budget should start a new turn without an explicit End Turn
          // click, and this is the plain-data signal that actually happened
          // (a single-player harness's next turn is its own turn again per
          // spec 01 "Notable Behavior", so currentPlayer alone can't tell).
          getTurn: (): number => world.getState().turn,
        };
      }

      bootstrap();
    </script>
  </body>
</html>
